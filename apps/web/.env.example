# ── Q-School web (apps/web) — copy to .env.local and fill in ──────────────────────

# Console sign-in (until Better Auth lands). CHANGE THESE before deploying.
ADMIN_EMAIL=admin@qschool.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Public HTTPS address of this app — used to show the webhook URLs in Console → Lead Sources.
PUBLIC_BASE_URL=https://app.qschool.com

# ── Meta Lead Ads (Facebook + Instagram) ── callback: /api/integrations/meta
META_APP_SECRET=
META_VERIFY_TOKEN=pick-any-random-string
META_PAGE_ACCESS_TOKEN=          # long-lived Page token with leads_retrieval
META_FORM_IDS=                   # optional, comma-separated — enables "Sync now"
# META_GRAPH_VERSION=v25.0

# ── Google Ads lead forms ── webhook: /api/integrations/google-ads
GOOGLE_ADS_WEBHOOK_KEY=pick-any-random-string

# ── WhatsApp Cloud API ── callback: /api/integrations/whatsapp
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=             # defaults to META_APP_SECRET if empty
WHATSAPP_TOKEN=                  # optional: for the instant auto-reply
WHATSAPP_PHONE_NUMBER_ID=        # optional
WHATSAPP_AUTO_REPLY=Hi {name}! Thanks for contacting Q-School. A counsellor will call you within 15 minutes.

# ── Other sources (JustDial, Sulekha, IndiaMART, Zapier/Make…) ──
# POST /api/integrations/webhook/<source>?key=<LEADS_WEBHOOK_KEY>
LEADS_WEBHOOK_KEY=pick-any-random-string

# Where the CRM JSON files live (default: apps/web). Postgres replaces this later.
# CRM_DATA_DIR=
